{
  "name": "snap-archive",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Snap Archive 的 Docker 版：在 NAS 已有的 DSH 容器里跑一个独立 node 服务，直接读写容器内已挂载的照片卷",
  "main": "server.mjs",
  "exports": {
    ".": "./server.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node server.mjs",
    "lint": "node lint.mjs",
    "test": "node test-api.mjs",
    "test:ui": "node test-ui.mjs",
    "check": "node lint.mjs && node test-api.mjs && node test-ui.mjs"
  },
  "devDependencies": {
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1"
  },
  "engines": {
    "node": ">=20.11"
  }
}
